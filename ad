-- Security Disabler Functions
local function disableLasers()
    if not SecurityDisabler.Enabled then return end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name:lower():find("laser") then
            for _, child in pairs(obj:GetDescendants()) do
                if child:IsA("BasePart") or child:IsA("MeshPart") then
                    child.CanTouch = false
                    child.CanQuery = false
                    child.Material = Enum.Material.Plastic
                    child.Transparency = 0.3
                end
            end
            
            if obj:IsA("BasePart") or obj:IsA("MeshPart") then
                obj.CanTouch = false
                obj.CanQuery = false
                obj.Material = Enum.Material.Plastic
                obj.Transparency = 0.3
            end
        end
    end
end

local function disableBarbedWire()
    if not SecurityDisabler.Enabled then return end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name:lower():find("barbedwire") then
            if obj:IsA("BasePart") then
                obj.CanQuery = false
                obj.CanTouch = false
                obj.CanCollide = false
                obj.Material = Enum.Material.Plastic
                obj.Transparency = 0.5
            end
            
            for _, child in pairs(obj:GetDescendants()) do
                if child:IsA("BasePart") then
                    child.CanQuery = false
                    child.CanTouch = false
                    child.CanCollide = false
                    child.Material = Enum.Material.Plastic
                    child.Transparency = 0.5
                end
            end
        end
    end
end

local function setupSecurityDisabler()
    -- Clear existing connections
    for _, conn in pairs(SecurityDisabler.Connections) do
        conn:Disconnect()
    end
    SecurityDisabler.Connections = {}
    
    if not SecurityDisabler.Enabled then return end
    
    -- Initial disable
    disableBarbedWire()
    disableLasers()
    
    -- Monitor for new objects
    local descendantConn = Workspace.DescendantAdded:Connect(function(obj)
        -- Handle BarbedWire objects
        if obj.Name:lower():find("barbedwire") then
            wait(0.1)
            
            if obj:IsA("BasePart") then
                obj.CanQuery = false
                obj.CanTouch = false
                obj.CanCollide = false
                obj.Material = Enum.Material.Plastic
                obj.Transparency = 0.5
            end
            
            for _, child in pairs(obj:GetDescendants()) do
                if child:IsA("BasePart") then
                    child.CanQuery = false
                    child.CanTouch = false
                    child.CanCollide = false
                    child.Material = Enum.Material.Plastic
                    child.Transparency = 0.5
                end
            end
        end
        
        -- Handle Laser objects
        if obj.Name:lower():find("laser") then
            wait(0.1)
            
            for _, child in pairs(obj:GetDescendants()) do
                if child:IsA("BasePart") or child:IsA("MeshPart") then
                    child.CanTouch = false
                    child.CanQuery = false
                    child.Material = Enum.Material.Plastic
                    child.Transparency = 0.3
                end
            end
            
            if obj:IsA("BasePart") or obj:IsA("MeshPart") then
                obj.CanTouch = false
                obj.CanQuery = false
                obj.Material = Enum.Material.Plastic
                obj.Transparency = 0.3
            end
        end
    end)
    
    table.insert(SecurityDisabler.Connections, descendantConn)
    
    -- Periodic refresh
    local heartbeatConn = RunService.Heartbeat:Connect(function()
        if tick() - SecurityDisabler.LastRefresh > 10 then
            SecurityDisabler.LastRefresh = tick()
            disableBarbedWire()
            disableLasers()
        end
    end)
    
    table.insert(SecurityDisabler.Connections, heartbeatConn)
end

-- Chams ESP system with Name ESP
local ChamsESP = {
    Enabled = baseConfig.ChamsEnabled,
    TeamCheck = baseConfig.ChamsTeamCheck,
    PlayerHighlights = {},
    PlayerNames = {},
    Opacity = 0.2,
    Colors = {
        Enemy = Color3.fromRGB(255, 0, 0),
        Team = Color3.fromRGB(0, 255, 0),
        Neutral = Color3.fromRGB(255, 255, 0)
    }
}

local function shouldShowChams(player)
    if not ChamsESP.Enabled then
        return false
    end
    
    if player == LocalPlayer then
        return false
    end
    
    if not player.Character then
        return false
    end
    
    if ChamsESP.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    
    return true
end

-- Function to create player name display
local function createPlayerNameDisplay(player)
    if ChamsESP.PlayerNames[player] then
        return ChamsESP.PlayerNames[player]
    end
    
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    
    -- Create ScreenGui for the name display
    local nameGui = Instance.new("ScreenGui")
    nameGui.Name = "NameESP_" .. player.Name
    nameGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    nameGui.IgnoreGuiInset = true
    nameGui.ResetOnSpawn = false
    nameGui.Enabled = false
    nameGui.Parent = playerGui
    
    -- Create text label for the name
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(0, 100, 0, 20)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.BackgroundTransparency = 0.5
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.Gotham
    nameLabel.BorderSizePixel = 0
    nameLabel.ZIndex = 10
    nameLabel.Parent = nameGui
    
    -- Rounded corners for the name background
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = nameLabel
    
    -- Store the GUI
    ChamsESP.PlayerNames[player] = nameGui
    return nameGui
end

-- Function to update player name display position
local function updatePlayerNameDisplay(player)
    if not ChamsESP.PlayerNames[player] then
        return
    end
    
    local nameGui = ChamsESP.PlayerNames[player]
    local character = player.Character
    
    if character and shouldShowChams(player) then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        
        if humanoid and humanoid.Health > 0 and rootPart then
            -- Position name under feet (slightly below HumanoidRootPart)
            local screenPos, onScreen = Camera:WorldToScreenPoint(rootPart.Position - Vector3.new(0, 3, 0))
            
            if onScreen then
                nameGui.Enabled = true
                local nameLabel = nameGui:FindFirstChild("NameLabel")
                if nameLabel then
                    nameLabel.Position = UDim2.new(0, screenPos.X - 50, 0, screenPos.Y)
                    
                    -- Update color based on team
                    if LocalPlayer.Team and player.Team then
                        if player.Team == LocalPlayer.Team then
                            nameLabel.TextColor3 = ChamsESP.Colors.Team
                        else
                            nameLabel.TextColor3 = ChamsESP.Colors.Enemy
                        end
                    else
                        nameLabel.TextColor3 = ChamsESP.Colors.Neutral
                    end
                end
            else
                nameGui.Enabled = false
            end
        else
            nameGui.Enabled = false
        end
    else
        nameGui.Enabled = false
    end
end

-- Function to remove player name display
local function removePlayerNameDisplay(player)
    if ChamsESP.PlayerNames[player] then
        ChamsESP.PlayerNames[player]:Destroy()
        ChamsESP.PlayerNames[player] = nil
    end
end

-- Function to update all name displays
local function updateAllNameDisplays()
    for player, nameGui in pairs(ChamsESP.PlayerNames) do
        updatePlayerNameDisplay(player)
    end
end

local function createPlayerHighlight(player)
    if ChamsESP.PlayerHighlights[player] then
        return ChamsESP.PlayerHighlights[player]
    end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "ChamsESP_" .. player.Name
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 1 - ChamsESP.Opacity
    highlight.OutlineTransparency = 0.3
    highlight.Adornee = nil
    
    if LocalPlayer.Team and player.Team then
        if player.Team == LocalPlayer.Team then
            highlight.FillColor = ChamsESP.Colors.Team
            highlight.OutlineColor = ChamsESP.Colors.Team
        else
            highlight.FillColor = ChamsESP.Colors.Enemy
            highlight.OutlineColor = ChamsESP.Colors.Enemy
        end
    else
        highlight.FillColor = ChamsESP.Colors.Neutral
        highlight.OutlineColor = ChamsESP.Colors.Neutral
    end
    
    ChamsESP.PlayerHighlights[player] = highlight
    
    -- Create name display when creating highlight
    createPlayerNameDisplay(player)
    
    return highlight
end

local function updatePlayerHighlight(player)
    if not ChamsESP.PlayerHighlights[player] then
        return
    end
    
    local highlight = ChamsESP.PlayerHighlights[player]
    local character = player.Character
    
    if character and shouldShowChams(player) then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 then
            highlight.Adornee = character
            highlight.Parent = character
            highlight.Enabled = true
            
            if LocalPlayer.Team and player.Team then
                if player.Team == LocalPlayer.Team then
                    highlight.FillColor = ChamsESP.Colors.Team
                    highlight.OutlineColor = ChamsESP.Colors.Team
                else
                    highlight.FillColor = ChamsESP.Colors.Enemy
                    highlight.OutlineColor = ChamsESP.Colors.Enemy
                end
            else
                highlight.FillColor = ChamsESP.Colors.Neutral
                highlight.OutlineColor = ChamsESP.Colors.Neutral
            end
        else
            highlight.Enabled = false
            highlight.Adornee = nil
            highlight.Parent = nil
        end
    else
        highlight.Enabled = false
        highlight.Adornee = nil
        highlight.Parent = nil
    end
    
    -- Update name display when updating highlight
    updatePlayerNameDisplay(player)
end

local function removePlayerHighlight(player)
    if ChamsESP.PlayerHighlights[player] then
        ChamsESP.PlayerHighlights[player]:Destroy()
        ChamsESP.PlayerHighlights[player] = nil
    end
    
    -- Remove name display when removing highlight
    removePlayerNameDisplay(player)
end

local function updateAllChams()
    for player, highlight in pairs(ChamsESP.PlayerHighlights) do
        updatePlayerHighlight(player)
    end
end

local function initializeChams()
    for player, highlight in pairs(ChamsESP.PlayerHighlights) do
        highlight:Destroy()
    end
    ChamsESP.PlayerHighlights = {}
    
    -- Clear name displays
    for player, nameGui in pairs(ChamsESP.PlayerNames) do
        nameGui:Destroy()
    end
    ChamsESP.PlayerNames = {}
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createPlayerHighlight(player)
            updatePlayerHighlight(player)
        end
    end
end

AddConnection(Players.PlayerAdded:Connect(function(player)
    createPlayerHighlight(player)
    updatePlayerHighlight(player)
    
    AddConnection(player.CharacterAdded:Connect(function(character)
        updatePlayerHighlight(player)
    end))
end))

AddConnection(Players.PlayerRemoving:Connect(function(player)
    removePlayerHighlight(player)
end))

local function setupFastCharacterMonitoring()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            AddConnection(player.CharacterAdded:Connect(function(character)
                updatePlayerHighlight(player)
            end))
            
            AddConnection(player.CharacterRemoving:Connect(function()
                if ChamsESP.PlayerHighlights[player] then
                    local highlight = ChamsESP.PlayerHighlights[player]
                    highlight.Enabled = false
                    highlight.Adornee = nil
                    highlight.Parent = nil
                end
            end))
        end
    end
end

-- Continuous name display update loop
AddConnection(RunService.Heartbeat:Connect(function()
    if not ChamsESP.Enabled then return end
    
    for player, nameGui in pairs(ChamsESP.PlayerNames) do
        if player and player.Parent then
