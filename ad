local noClipIndicator = createNoClipIndicator()
local noClipEnabled = false

-- =============================================
-- NOCIP SYSTEM
-- =============================================
do
    local noclip = false
    local clip = nil
    
    local function noclipLoop()
        if clip == nil then
            clip = RunService.Stepped:Connect(function()
                if noclip == true and LocalPlayer.Character ~= nil then
                    for _, child in pairs(LocalPlayer.Character:GetDescendants()) do
                        if child:IsA("BasePart") and child.CanCollide == true then
                            child.CanCollide = false
                        end
                    end
                end
            end)
        end
    end
    
    local function toggleNoClip()
        noclip = not noclip
        noClipEnabled = noclip
        
        -- Update indicator color
        if noclip then
            noClipIndicator.BackgroundColor3 = Color3.new(0, 1, 0) -- Green when active
            print("✅ NoClip: ENABLED")
        else
            noClipIndicator.BackgroundColor3 = Color3.new(0, 0, 0) -- Black when inactive
            print("❌ NoClip: DISABLED")
        end
        
        if noclip then
            noclipLoop()
        elseif clip then
            clip:Disconnect()
            clip = nil
            
            -- Re-enable collision when turning off noclip
            if LocalPlayer.Character then
                for _, child in pairs(LocalPlayer.Character:GetDescendants()) do
                    if child:IsA("BasePart") then
                        child.CanCollide = true
                    end
                end
            end
        end
    end
    
    -- N key toggle for NoClip
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.Q then
            toggleNoClip()
        end
    end)
    
    -- Auto-reconnect noclip when character respawns
    LocalPlayer.CharacterAdded:Connect(function(character)
        if noclip then
            wait(1) -- Wait for character to fully load
            noclipLoop()
        end
    end)
    
    print("✅ NoClip system loaded! Press N to toggle")
end

