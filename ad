-- MEMORY LEAK FIX: Cleanup System
local Connections = {}
local function AddConnection(connection)
    table.insert(Connections, connection)
    return connection
end

local function CleanupAll()
    print("🧹 Cleaning up memory...")
    
    -- Disconnect all connections
    for _, conn in ipairs(Connections) do
        if conn and typeof(conn) == "RBXScriptConnection" then
            conn:Disconnect()
        end
    end
    Connections = {}
    
    -- Clean up Chams
    for player, highlight in pairs(ChamsESP.PlayerHighlights or {}) do
        if highlight then
            highlight:Destroy()
        end
    end
    ChamsESP.PlayerHighlights = {}
    
    for player, nameGui in pairs(ChamsESP.PlayerNames or {}) do
        if nameGui then
            nameGui:Destroy()
        end
    end
    ChamsESP.PlayerNames = {}
    
    -- Clean up Security Disabler
    for _, conn in pairs(SecurityDisabler.Connections or {}) do
        if conn then conn:Disconnect() end
    end
    SecurityDisabler.Connections = {}
    
    -- Clean up FOV Circle
    if FOVCircle then
        FOVCircle.Parent:Destroy()
        FOVCircle = nil
    end
    
    -- Clean up GUI
    if mainGui then
        mainGui:Destroy()
        mainGui = nil
    end
    
    print("✅ Cleanup completed!")
end

