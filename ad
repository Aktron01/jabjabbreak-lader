        end,
        UpdateSecurityDisabler = function(state)
            securityDisablerToggle.SetState(state)
        end,
        ToggleVisibility = function()
            mainGui.Enabled = not mainGui.Enabled
        end,
        GetGUI = function()
            return mainGui
        end,
        IsValid = function()
            return mainGui and mainGui.Parent ~= nil
        end
    }
    
    return controlTable
end

