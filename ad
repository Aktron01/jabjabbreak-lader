-- Team check function
local function isTeammate(player)
    if not baseConfig.TeamCheck then
        return false
    end
    
    if not LocalPlayer.Team then
        return false
    end
    
    return player.Team == LocalPlayer.Team
end

-- Enhanced death detection function
local function isPlayerAlive(player)
    if not player.Character then
        return false
    end
    
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false
    end
    
    -- Check health
    if humanoid.Health <= 0 then
        return false
    end
    
    -- Check if humanoid is in a dead state
    local humanoidState = humanoid:GetState()
    if humanoidState == Enum.HumanoidStateType.Dead then
        return false
    end
    
    -- Additional check: if the character is falling through the map (below kill plane)
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Head")
    if rootPart then
        -- Most games have kill zones below -500 studs
        if rootPart.Position.Y < -500 then
            return false
        end
    end
    
    return true
end

-- Function to check if player is valid target (alive and not falling through map)
local function isValidTarget(player)
    if not player.Character then
        return false
    end
    
    if not isPlayerAlive(player) then
        return false
    end
    
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Head")
    if not rootPart then
        return false
    end
    
    -- Additional safety check: if character is too far below map
    if rootPart.Position.Y < -1000 then
        return false
    end
    
    return true
end

-- FOV implementation
local function findBestTarget()
    local bestTarget = nil
    local closestDistance = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        
        if isTeammate(player) then
            continue
        end
        
        -- Use enhanced target validation
        if not isValidTarget(player) then
            continue
        end
        
        local aimPart = player.Character:FindFirstChild("Head") or 
                       player.Character:FindFirstChild("HumanoidRootPart")
        
        if not aimPart then continue end
        
        local distance = (aimPart.Position - Camera.CFrame.Position).Magnitude
        if distance > baseConfig.MaxDistance then continue end
        
        local screenPos, onScreen = Camera:WorldToScreenPoint(aimPart.Position)
        if not onScreen then continue end
        
        local mousePos = UserInput:GetMouseLocation()
        local distanceToMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local distanceToCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        
        if distanceToCenter > (baseConfig.FOV / 2) then
            continue
        end
        
        if distanceToMouse < closestDistance then
            closestDistance = distanceToMouse
            bestTarget = player
        end
    end
    
    return bestTarget
end

local function smoothAimAt(targetPos)
    if not targetPos then return end
    
    local currentCFrame = Camera.CFrame
    local targetCFrame = CFrame.new(currentCFrame.Position, targetPos)
    
    local magneticStrength = 1 - baseConfig.Smoothing
    
    local smoothedCFrame = currentCFrame:Lerp(targetCFrame, magneticStrength)
    
    local success, err = pcall(function()
        Camera.CFrame = smoothedCFrame
    end)
    
    if not success then
        if GUI and GUI.SetStatus then
            GUI.SetStatus("Camera error")
        end
    end
end

local mouseMovementResistance = 0
local lastMousePos = UserInput:GetMouseLocation()

AddConnection(UserInput.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        local currentMousePos = UserInput:GetMouseLocation()
        local mouseDelta = (currentMousePos - lastMousePos).Magnitude
        lastMousePos = currentMousePos
        
        if mouseDelta > 5 then
            mouseMovementResistance = math.min(mouseMovementResistance + 0.1, 1.0)
        else
            mouseMovementResistance = math.max(mouseMovementResistance - 0.05, 0)
        end
    end
end))

local isAiming = false
local currentTarget = nil

AddConnection(UserInput.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- Aimlock with LeftControl
    if input.KeyCode == baseConfig.AimButton and baseConfig.Enabled then
        isAiming = true
        mouseMovementResistance = 0
        if GUI and GUI.SetStatus then
            GUI.SetStatus("Finding target...")
        end
    end
    
    -- GUI toggle with RightControl
    if input.KeyCode == Enum.KeyCode.RightControl then
        if GUI and GUI.ToggleVisibility then
            GUI.ToggleVisibility()
        else
            ensureGUI()
        end
    end
end))

AddConnection(UserInput.InputEnded:Connect(function(input, gameProcessed)
    if input.KeyCode == baseConfig.AimButton then
        isAiming = false
        currentTarget = nil
        mouseMovementResistance = 0
        if GUI and GUI.SetStatus then
            GUI.SetStatus("Ready - Hold LeftCtrl")
        end
    end
end))

AddConnection(RunService.RenderStepped:Connect(function()
    if not GUI or not GUI.IsValid or not GUI.IsValid() then
        ensureGUI()
    end
    
    if not baseConfig.Enabled or not isAiming then return end
    
    -- Enhanced target validation with better death detection
    if currentTarget then
        local isValid = isValidTarget(currentTarget)
        
        if not isValid then
            if GUI and GUI.SetStatus then
                GUI.SetStatus("Target invalid, finding new target...")
            end
            currentTarget = findBestTarget()
            if currentTarget then
                if GUI and GUI.SetStatus then
                    GUI.SetStatus("Locked: " .. currentTarget.Name)
                end
            else
                if GUI and GUI.SetStatus then
                    GUI.SetStatus("No valid targets found")
                end
                return
            end
        end
    end
    
    if not currentTarget then
        currentTarget = findBestTarget()
        if not currentTarget then
            if GUI and GUI.SetStatus then
                GUI.SetStatus("No targets found")
            end
            return
        end
        if GUI and GUI.SetStatus then
            GUI.SetStatus("Locked: " .. currentTarget.Name)
        end
    end
    
    -- Validate target
    if not currentTarget.Character then
        currentTarget = nil
        return
    end
    
    if baseConfig.TeamCheck and isTeammate(currentTarget) then
        currentTarget = nil
        if GUI and GUI.SetStatus then
            GUI.SetStatus("Target is teammate")
        end
        return
    end
    
    -- Use enhanced validation
    if not isValidTarget(currentTarget) then
        currentTarget = nil
        if GUI and GUI.SetStatus then
            GUI.SetStatus("Target died")
        end
        return
    end
    
    local aimPart = currentTarget.Character:FindFirstChild("Head") or 
                   currentTarget.Character:FindFirstChild("HumanoidRootPart")
    
    if not aimPart then
        currentTarget = nil
        return
    end
    
    -- Additional check - if aim part is too far underground
    if aimPart.Position.Y < -500 then
        currentTarget = nil
        if GUI and GUI.SetStatus then
            GUI.SetStatus("Target underground")
        end
        return
    end
    
    local targetPos = aimPart.Position
    if baseConfig.UsePrediction then
        targetPos = targetPos + (aimPart.Velocity * baseConfig.Prediction)
    end
    
    local effectiveMagneticStrength = baseConfig.Smoothing
    if mouseMovementResistance > 0.3 then
        effectiveMagneticStrength = math.min(baseConfig.Smoothing + mouseMovementResistance, 1.0)
    end
    
    local originalSmoothness = baseConfig.Smoothing
    baseConfig.Smoothing = effectiveMagneticStrength
    
    smoothAimAt(targetPos)
    
    baseConfig.Smoothing = originalSmoothness
    
    if GUI and GUI.SetStatus then
        local distance = (targetPos - Camera.CFrame.Position).Magnitude
        local teamStatus = baseConfig.TeamCheck and " (Team Check ON)" or " (Team Check OFF)"
        local magneticInfo = string.format(" | Magnetic: %.0f%%", (1 - baseConfig.Smoothing) * 100)
        GUI.SetStatus("Locked: " .. currentTarget.Name .. " | " .. math.floor(distance) .. " studs" .. magneticInfo)
    end
end))

