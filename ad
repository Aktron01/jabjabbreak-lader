-- =============================================
-- INFINITE JUMP SCRIPT
-- =============================================
do
    local Player = Players.LocalPlayer
    local UIS = UserInputService

    _G.JumpHeight = 50

    local function Action(Object, Function) 
        if Object ~= nil then 
            Function(Object) 
        end 
    end

    UIS.InputBegan:connect(function(UserInput)
        if UserInput.UserInputType == Enum.UserInputType.Keyboard and UserInput.KeyCode == Enum.KeyCode.Space then
            if Player.Character and Player.Character:FindFirstChild("Humanoid") then
                Action(Player.Character.Humanoid, function(self)
                    if self:GetState() == Enum.HumanoidStateType.Jumping or self:GetState() == Enum.HumanoidStateType.Freefall then
                        Action(self.Parent.HumanoidRootPart, function(self)
                            self.Velocity = Vector3.new(0, _G.JumpHeight, 0)
                        end)
                    end
                end)
            end
        end
    end)

    print("✅ Infinite Jump activated! Press Space to use.")
end

-- =============================================
-- DASH GUI SCRIPT
-- =============================================
do
    -- Cleanup old
    if CoreGui:FindFirstChild("DashGui") then
        CoreGui:FindFirstChild("DashGui"):Destroy()
    end

    -- GUI Setup
    local gui = Instance.new("ScreenGui", CoreGui)
    gui.Name = "DashGui"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true

    -- Center Message
    local msg = Instance.new("TextLabel", gui)
    msg.Size = UDim2.new(0, 400, 0, 50)
    msg.Position = UDim2.new(0.5, -200, 0.4, 0)
    msg.Text = "Double Tap W to Dash in Look Direction"
    msg.Font = Enum.Font.GothamBlack
    msg.TextSize = 22
    msg.TextColor3 = Color3.new(1, 1, 1)
    msg.BackgroundTransparency = 0.2
    msg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Instance.new("UICorner", msg).CornerRadius = UDim.new(0, 6)

    -- Fade out after 5 seconds
    task.delay(5, function()
        local fade = TweenService:Create(msg, TweenInfo.new(1), {TextTransparency = 1, BackgroundTransparency = 1})
        fade:Play()
        fade.Completed:Wait()
        msg:Destroy()
    end)

    -- Dash logic
    local dashEnabled = true
    local dashCooldown = false
    local dashDistance = 40
    local dashTime = 0.30

    -- Double tap tracking for W only
    local lastWTapTime = 0
    local doubleTapThreshold = 0.3 -- seconds between taps

    -- Dash function
    local function performDash()
        if not dashEnabled or dashCooldown then return end
        
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart

        -- Get camera look direction (where player is looking)
        local camera = Workspace.CurrentCamera
        local lookVector = camera.CFrame.LookVector
        
        -- Remove Y component to keep dash horizontal, then normalize
        local horizontalLookVector = Vector3.new(lookVector.X, 0, lookVector.Z)
        if horizontalLookVector.Magnitude > 0 then
            horizontalLookVector = horizontalLookVector.Unit
        else
            -- Fallback to character forward if looking straight up/down
            horizontalLookVector = hrp.CFrame.LookVector * Vector3.new(1, 0, 1)
            horizontalLookVector = horizontalLookVector.Unit
        end
        
        -- Dash in look direction
        local dirVec = horizontalLookVector * dashDistance

        -- Slide dash via Tween
        local goal = hrp.Position + dirVec
        local tween = TweenService:Create(hrp, TweenInfo.new(dashTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
            CFrame = CFrame.new(goal, goal + horizontalLookVector)
        })
        tween:Play()

        -- Particle FX
        local attachment = Instance.new("Attachment", hrp)
        local emitter = Instance.new("ParticleEmitter", attachment)
        emitter.Texture = "rbxassetid://9119048717" -- basic wind swirl
        emitter.Rate = 999
        emitter.Lifetime = NumberRange.new(0.2)
        emitter.Speed = NumberRange.new(0)
        emitter.Size = NumberSequence.new(1)
        emitter.Rotation = NumberRange.new(0, 360)
        emitter.SpreadAngle = Vector2.new(360, 360)
        Debris:AddItem(attachment, 0.3)

        -- Cooldown
        dashCooldown = true
        task.delay(0.5, function()
            dashCooldown = false
        end)
    end

    -- Double tap detection for W only
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        
        if input.KeyCode == Enum.KeyCode.W then
            local currentTime = tick()
            
            -- Check if this is a double tap
            if currentTime - lastWTapTime <= doubleTapThreshold then
                -- Double tap detected - perform dash
                performDash()
                -- Reset the timer to prevent triple-tap detection
                lastWTapTime = 0
            else
                -- First tap - record the time
                lastWTapTime = currentTime
            end
        end
    end)

    print("✅ Dash GUI activated! Double-tap W to dash.")
end

